# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git or expose keys in frontend JavaScript.

PORT=3000

# Optional: Add your Gemini API key in Milestone 3 when enabling the AI Chatbot.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Default AQI mode ("demo" or "live")
DEFAULT_AQI_MODE=demo
